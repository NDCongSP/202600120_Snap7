<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--<TargetFramework>net8.0</TargetFramework>-->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString("MMdd.HHmm"))</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).$(VersionSuffix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(VersionSuffix)</FileVersion>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <Copyright>PT Automation Solution</Copyright>
    <Description>Mitsubishi MC Protocol SCADA driver – Q/L/iQ-R/FX series – .NET Standard 2.0</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cho phép test project truy cập internal types (PlcAddressParser, PlcDeviceCode, v.v.) -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>McProtocolScada.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tags.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyLibraryAfterBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DestinationFolder>D:\3.Others\0.Code\McProtocolScada\Release_Lib</DestinationFolder>
    </PropertyGroup>

    <Message Text="Starting copy library files to $(DestinationFolder)..." Importance="high" />

    <MakeDir Directories="$(DestinationFolder)" />

    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DestinationFolder)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(DestinationFolder)" />

    <Message Text="Copy completed successfully!" Importance="high" />
  </Target>

</Project>
