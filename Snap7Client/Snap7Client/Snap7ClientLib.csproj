<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Snap7ClientLib</PackageId>
    <Version>1.0.0</Version>
    <Authors>Phuc Thinh Automation</Authors>
    <Company>Phuc Thinh Automation</Company>
    <Description>Siemens S7 PLC Driver based on Snap7</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NDCongSP/202600120_Snap7</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sharp7" Version="1.1.84" />
  </ItemGroup>

</Project>
