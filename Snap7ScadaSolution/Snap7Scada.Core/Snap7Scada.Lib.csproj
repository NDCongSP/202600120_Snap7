<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--<TargetFramework>net8.0</TargetFramework>-->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString("MMdd.HHmm"))</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix).$(VersionSuffix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(VersionSuffix)</FileVersion>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <Copyright>PT Automation Solution</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Sharp7" Version="1.1.84" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tags.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyLibraryAfterBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DestinationFolder>D:\3.Others\0.Code\202600120_Snap7\Snap7ScadaSolution\Release_Lib</DestinationFolder>
    </PropertyGroup>

    <Message Text="Starting copy library files to $(DestinationFolder)..." Importance="high" />

    <MakeDir Directories="$(DestinationFolder)" />

    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DestinationFolder)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(DestinationFolder)" />

    <Message Text="Copy completed successfully!" Importance="high" />
  </Target>

</Project>
